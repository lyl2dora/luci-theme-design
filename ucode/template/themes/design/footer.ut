{% if (!blank_page): %}
			</div>{# .container #}
			<footer class="mobile-hide">
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">Powered by {{ version.luciname }} ({{ version.luciversion }})</a>
				/ {{ version.distname }} {{ version.distversion }}
				{% if (lua_active): %}/ {{ _('Lua compatibility mode active') }}{% endif %}
			</footer>
		</div>{# #maincontent #}
	</div>{# .main-right #}
</div>{# .main #}

<script>L.require('menu-design')</script>
{% endif %}
</body>
</html>
